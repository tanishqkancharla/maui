{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"emitDeclarationOnly": false,
		"outDir": "dist",
		"rootDir": "src",
		"noEmit": false,
		"noEmitOnError": true
	},
	"include": [
		"src/maui.ts",
		"src/components/Editor.tsx",
		"src/components/MarkdownEditor.tsx",
		"src/types/**/*.d.ts",
		"src/css-modules.d.ts"
	]
}
