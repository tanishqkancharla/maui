{
	"name": "maui",
	"version": "0.0.1",
	"description": "Maui design system",
	"type": "module",
	"main": "./dist/maui.js",
	"types": "./dist/maui.d.ts",
	"source": "./src/maui.ts",
	"files": [
		"dist",
		"src"
	],
	"exports": {
		".": {
			"types": "./dist/maui.d.ts",
			"import": "./dist/maui.js"
		}
	},
	"scripts": {
		"tsc": "tsc --noEmit --watch",
		"clear": "mkdir -p dist && rm -rf dist/*",
		"dev": "vite",
		"build": "vite build",
		"build:lib": "tsc -p tsconfig.lib.json",
		"prepare": "npm run build:lib",
		"serve": "vite preview",
		"deploy": "npx vercel deploy",
		"test": "vitest",
		"mcp:browser": "node .cursor/libretto-browser-mcp.mjs",
		"libretto:smoke": "libretto run src/workflows/scrape-page.ts --headless"
	},
	"author": "Tanishq Kancharla",
	"license": "MIT",
	"devDependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@types/dedent": "^0.7.2",
		"@types/lodash": "^4.17.24",
		"@types/node": "^25.9.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"esbuild": "^0.28.0",
		"libretto": "^0.6.39",
		"libretto-browser-tools": "^0.1.2",
		"process": "^0.11.10",
		"serve": "^14.2.6",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vercel": "^54.10.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@radix-ui/colors": "^3.0.0",
		"@react-spring/web": "^10.1.0",
		"@types/inline-style-prefixer": "^5.0.3",
		"dedent": "^1.7.2",
		"inline-style-prefixer": "^7.0.1",
		"leva": "^0.10.1",
		"lodash": "^4.18.1",
		"purse-styles": "^0.2.1",
		"react": "^19.2.7",
		"react-aria": "^3.49.0",
		"react-aria-components": "^1.19.0",
		"react-dom": "^19.2.7",
		"react-stately": "^3.47.0",
		"shiki": "^4.3.0",
		"tuple-database": "^2.2.4",
		"use-state-dispatch": "^0.6.0",
		"wouter": "^3.10.0"
	}
}
