{
	"name": "@tanishqkancharla/maui",
	"version": "0.0.14",
	"description": "Maui design system",
	"type": "module",
	"main": "./dist/maui.js",
	"types": "./dist/maui.d.ts",
	"source": "./src/maui.ts",
	"files": [
		"dist",
		"src",
		"skills",
		"LICENSE",
		"NOTICE"
	],
	"sideEffects": [
		"**/*.css",
		"./dist/MauiProvider.js",
		"./src/MauiProvider.tsx"
	],
	"exports": {
		".": {
			"source": "./src/maui.ts",
			"types": "./dist/maui.d.ts",
			"import": "./dist/maui.js",
			"default": "./dist/maui.js"
		},
		"./icons": {
			"source": "./src/icons/index.ts",
			"types": "./dist/icons/index.d.ts",
			"import": "./dist/icons/index.js",
			"default": "./dist/icons/index.js"
		},
		"./src": "./src/maui.ts",
		"./src/*": "./src/*",
		"./skills/maui": "./skills/maui/SKILL.md",
		"./skills/maui/*": "./skills/maui/*",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tanishqkancharla/maui.git"
	},
	"scripts": {
		"tsc": "tsc --noEmit --watch",
		"typecheck": "tsc --noEmit",
		"clear": "mkdir -p dist && rm -rf dist/*",
		"dev": "vite",
		"build": "npm run og && vite build",
		"build:lib": "tsc -p tsconfig.lib.json",
		"prepack": "npm run build:lib",
		"verify-package": "node scripts/verify-package.mjs",
		"og": "node scripts/generate-og-image.mjs",
		"serve": "vite preview",
		"deploy": "npx vercel deploy",
		"test": "vitest",
		"mcp:browser": "node .cursor/libretto-browser-mcp.mjs",
		"mcp:agentation": "node .cursor/agentation-mcp.mjs",
		"release": "npm publish --access public --provenance"
	},
	"author": "Tanishq Kancharla",
	"license": "MIT",
	"devDependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@resvg/resvg-js": "^2.6.2",
		"@types/dedent": "^0.7.2",
		"@types/lodash": "^4.17.24",
		"@types/node": "^25.9.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"agentation": "^3.0.2",
		"agentation-mcp": "^1.2.0",
		"esbuild": "^0.28.0",
		"libretto-browser-tools": "^0.1.2",
		"process": "^0.11.10",
		"satori": "^0.29.0",
		"serve": "^14.2.6",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vercel": "^54.10.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/language": "^6.12.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.9",
		"@fontsource/commit-mono": "^5.3.0",
		"@lezer/highlight": "^1.2.3",
		"@radix-ui/colors": "^3.0.0",
		"@react-spring/web": "^10.1.0",
		"@streamdown/code": "^1.1.1",
		"@tiptap/extension-placeholder": "^3.29.2",
		"@tiptap/markdown": "^3.29.2",
		"@tiptap/pm": "^3.29.2",
		"@tiptap/react": "^3.29.2",
		"@tiptap/starter-kit": "^3.29.2",
		"@types/inline-style-prefixer": "^5.0.3",
		"@uiw/react-codemirror": "^4.25.11",
		"dedent": "^1.7.2",
		"inline-style-prefixer": "^7.0.1",
		"lodash": "^4.18.1",
		"prettier": "^3.9.6",
		"purse-styles": "^0.2.3",
		"react": "^19.0.0",
		"react-aria": "^3.49.0",
		"react-aria-components": "^1.19.0",
		"react-dom": "^19.0.0",
		"react-stately": "^3.47.0",
		"shiki": "^4.3.0",
		"streamdown": "^2.5.0",
		"sucrase": "^3.35.1",
		"tuple-database": "^2.2.4",
		"use-state-dispatch": "^0.6.0",
		"wouter": "^3.10.0"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	}
}
