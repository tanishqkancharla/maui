{
	"compilerOptions": {
		"jsx": "react-jsx",
		"target": "ESNext",
		"typeRoots": ["node_modules/@types", "src/types"],
		"types": ["node"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	}
}
